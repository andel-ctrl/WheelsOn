# ==============================================================================
# WheelsOn - Plantilla de Variables de Entorno (.env.example)
# ==============================================================================

DJANGO_SECRET_KEY=cambiar-esta-clave-secreta-en-produccion
# True para desarrollar. Para presentar usa False: así un error o una dirección inventada
# muestran páginas propias y no las páginas técnicas de Django.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Acceso rapido y Cambiar perspectiva. Ponlo en False si la app se publica.
WHEELSON_MODO_DEMO=True

# Conexion Neo4j Bolt
NEO4J_BOLT_URL=bolt://neo4j:password@localhost:7687
NEO4J_ENCRYPTED=False
